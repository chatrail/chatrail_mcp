{
  "instructions": "Operational tools for one ChatRail workspace: connections, WhatsApp groups, message delivery, schedules and webhook deliveries. Message bodies, recipient numbers and credentials are never returned. Tools that change state return a preview first and apply only when called again with confirm: true.",
  "tools": [
    {
      "name": "list_connections",
      "title": "List connections",
      "description": "Every WhatsApp connection in the workspace with its current state and health. Phone numbers are not included.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_connection",
      "title": "Get a connection",
      "description": "One connection, with its state, health and recent state history.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "connection"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_whatsapp_groups",
      "title": "List WhatsApp groups",
      "description": "A bounded page of groups visible to one connected WhatsApp number. Returns group names, stable group ids and participant counts when available; participant identities are never returned.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "connection"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_whatsapp_group",
      "title": "Describe a WhatsApp group",
      "description": "Name, description, settings and member counts for one group a connected number is in. Like list_whatsapp_groups, it never returns who the members are.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "group_id": {
            "type": "string",
            "minLength": 5,
            "maxLength": 40
          }
        },
        "required": [
          "connection",
          "group_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_messages",
      "title": "List messages",
      "description": "Recent messages with their delivery state. Message bodies and recipient numbers are deliberately excluded.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "direction": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound"
            ]
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "cursor": {
            "type": "string",
            "maxLength": 200
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_message",
      "title": "Get a message",
      "description": "One message and its delivery timeline. The body is not returned.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "message_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "explain_message_failure",
      "title": "Explain why a message failed",
      "description": "A structured explanation derived from the failure classification recorded when the message failed. Deterministic — it does not summarise logs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "message_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_scheduled_messages",
      "title": "List scheduled messages",
      "description": "Messages waiting to be sent, soonest first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "cursor": {
            "type": "string",
            "maxLength": 200
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_webhook_deliveries",
      "title": "List webhook deliveries",
      "description": "Recent customer webhook deliveries and their outcomes. Payloads and endpoint URLs are not returned.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "delivered",
              "failed",
              "dead",
              "skipped"
            ]
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "reschedule_message",
      "title": "Move a scheduled message",
      "description": "Change when a scheduled message will be sent. Returns a preview of the change; pass confirm: true to apply it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "send_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "confirm": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "message_id",
          "send_at"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "cancel_scheduled_message",
      "title": "Cancel a scheduled message",
      "description": "Cancel a message that has not yet been sent. Returns a preview; pass confirm: true to apply it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "confirm": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "message_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "react_to_message",
      "title": "React to a message",
      "description": "Set this number's emoji reaction on a message it sent or received, or remove it with an empty emoji. The person in the chat sees it. Returns a preview; pass confirm: true to apply.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "emoji": {
            "type": "string",
            "maxLength": 16
          },
          "confirm": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "message_id",
          "emoji"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "replay_webhook",
      "title": "Replay a failed webhook delivery",
      "description": "Return a dead or skipped webhook delivery to the queue. Returns a preview; pass confirm: true to apply it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "delivery_id": {
            "type": "string",
